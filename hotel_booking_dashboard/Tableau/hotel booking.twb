          <datasource-dependencies datasource='federated.0vmqqvo0e8mv791a753hb1q28frj'>
            <column caption='month gredient weight' datatype='integer' name='[Calculation_0571230759112715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [arrival_date_month]&#13;&#10;    WHEN &apos;January&apos;   THEN 1   // Lightest&#13;&#10;    WHEN &apos;February&apos;  THEN 2&#13;&#10;    WHEN &apos;March&apos;     THEN 3&#13;&#10;    WHEN &apos;April&apos;     THEN 3&#13;&#10;    WHEN &apos;May&apos;       THEN 4&#13;&#10;    WHEN &apos;June&apos;      THEN 4&#13;&#10;    WHEN &apos;July&apos;      THEN 5   // Darkest&#13;&#10;    WHEN &apos;August&apos;    THEN 5   // Darkest&#13;&#10;    WHEN &apos;September&apos; THEN 4   // Dropping back down to Mid-Tone&#13;&#10;    WHEN &apos;October&apos;   THEN 4&#13;&#10;    WHEN &apos;November&apos;  THEN 3&#13;&#10;    WHEN &apos;December&apos;  THEN 3&#13;&#10;END' />
            </column>
            <column caption='Arrival Date Month' datatype='string' name='[arrival_date_month]' role='dimension' type='nominal' />
            <column-instance column='[is_canceled]' derivation='Count' name='[cnt:is_canceled:qk]' pivot='key' type='quantitative' />
