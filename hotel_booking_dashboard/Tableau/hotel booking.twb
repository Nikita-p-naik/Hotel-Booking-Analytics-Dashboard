      <aliases enabled='yes' />
      <column caption='Total stay Night' datatype='integer' name='[Calculation_0571230733484032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[stays_in_week_nights] + [stays_in_weekend_nights]' />
      </column>
      <column caption='Cancellation flag' datatype='string' name='[Calculation_0571230733647873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_canceled] = 1 THEN &quot;Cancelled&quot;&#13;&#10;ELSE &quot;Not Cancelled&quot;&#13;&#10;END' />
      </column>
      <column caption='Cancellation Rate' datatype='real' default-format='p0.0%' name='[Calculation_0571230733795330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_canceled]) / COUNT([is_canceled])' />
      </column>
      <column caption='Estimated Room Value' datatype='real' name='[Calculation_0571230734508035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[adr] * ([stays_in_week_nights] + [stays_in_weekend_nights])' />
      </column>
      <column caption='Total Bookings' datatype='integer' name='[Calculation_0571230736642053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([is_canceled])' />
      </column>
      <column caption='Total Countries' datatype='integer' name='[Calculation_0571230736781318]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([country])' />
      </column>
      <column caption='Avg Adr' datatype='real' name='[Calculation_0571230737088519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([adr])' />
      </column>
      <column caption='Avg Lead Time' datatype='real' name='[Calculation_0571230737657864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([lead_time])' />
      </column>
      <column caption='Repeat Guest %' datatype='real' name='[Calculation_0571230737940489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_repeated_guest]) / COUNT([is_canceled])' />
      </column>
      <column caption='Avg Stay Length' datatype='real' name='[Calculation_0571230745804810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0571230733484032])' />
      </column>
      <column caption='month gredient weight' datatype='integer' name='[Calculation_0571230759112715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [arrival_date_month]&#13;&#10;    WHEN &apos;January&apos;   THEN 1   // Lightest&#13;&#10;    WHEN &apos;February&apos;  THEN 2&#13;&#10;    WHEN &apos;March&apos;     THEN 3&#13;&#10;    WHEN &apos;April&apos;     THEN 3&#13;&#10;    WHEN &apos;May&apos;       THEN 4&#13;&#10;    WHEN &apos;June&apos;      THEN 4&#13;&#10;    WHEN &apos;July&apos;      THEN 5   // Darkest&#13;&#10;    WHEN &apos;August&apos;    THEN 5   // Darkest&#13;&#10;    WHEN &apos;September&apos; THEN 4   // Dropping back down to Mid-Tone&#13;&#10;    WHEN &apos;October&apos;   THEN 4&#13;&#10;    WHEN &apos;November&apos;  THEN 3&#13;&#10;    WHEN &apos;December&apos;  THEN 3&#13;&#10;END' />
      </column>
      <column caption='hist label' datatype='integer' name='[Calculation_0571230801186828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNT([is_canceled]) &gt;= 500 THEN COUNT([is_canceled]) END' />
      </column>
      <column caption='Lead Time Group' datatype='string' name='[Calculation_0571230802571277]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [lead_time] &lt;= 30 THEN &quot;0-30&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 60 THEN &quot;31-60&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 90 THEN &quot;61-90&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 120 THEN &quot;91-120&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 180 THEN &quot;121-180&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 360 THEN &quot;181-360&quot;&#13;&#10;ELSE &quot;360+&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Country' datatype='integer' name='[Calculation_0571230806032398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([country])' />
      </column>
      <column caption='repeat guest %' datatype='real' name='[Calculation_0571230818926608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_repeated_guest]) / COUNT([is_canceled])' />
      </column>
