    <worksheet name='lead time distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#2d6316' fontsize='12'>Lead Time Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hotel_booking_data_cleaned' name='federated.0vmqqvo0e8mv791a753hb1q28frj' />
          </datasources>
          <datasource-dependencies datasource='federated.0vmqqvo0e8mv791a753hb1q28frj'>
            <column caption='hist label' datatype='integer' name='[Calculation_0571230801186828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNT([is_canceled]) &gt;= 500 THEN COUNT([is_canceled]) END' />
            </column>
            <column caption='Lead Time Group' datatype='string' name='[Calculation_0571230802571277]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lead_time] &lt;= 30 THEN &quot;0-30&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 60 THEN &quot;31-60&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 90 THEN &quot;61-90&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 120 THEN &quot;91-120&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 180 THEN &quot;121-180&quot;&#13;&#10;ELSEIF [lead_time] &lt;= 360 THEN &quot;181-360&quot;&#13;&#10;ELSE &quot;360+&quot;&#13;&#10;END' />
            </column>
            <column caption='Arrival Date Month' datatype='string' name='[arrival_date_month]' role='dimension' type='nominal' />
            <column-instance column='[is_canceled]' derivation='Count' name='[cnt:is_canceled:qk]' pivot='key' type='quantitative' />
            <column caption='Customer Type' datatype='string' name='[customer_type]' role='dimension' type='nominal' />
            <column caption='Hotel' datatype='string' name='[hotel]' role='dimension' type='nominal' />
            <column caption='Is Canceled' datatype='integer' name='[is_canceled]' role='measure' type='quantitative' />
            <column caption='Lead Time' datatype='integer' name='[lead_time]' role='measure' type='quantitative' />
            <column caption='Market Segment' datatype='string' name='[market_segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0571230802571277]' derivation='None' name='[none:Calculation_0571230802571277:nk]' pivot='key' type='nominal' />
